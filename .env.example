# RepoRadar configuration. Copy to .env (never commit real values) and export,
# or set these in your process manager. Every value here is a placeholder.

# --- Web server
HOST=127.0.0.1
PORT=8787
# NODE_ENV=production
# Public origin used for CSRF origin checks behind a proxy, e.g. https://reporadar.example.com
# REPORADAR_PUBLIC_ORIGIN=
# Set to true only when behind exactly one trusted reverse proxy that sets X-Forwarded-For.
# REPORADAR_TRUST_PROXY=false
# Defaults to true when NODE_ENV=production.
# REPORADAR_SECURE_COOKIES=

# --- Branding
# REPORADAR_PRODUCT_NAME=RepoRadar

# --- GitHub (server-side only; never passed to the sandbox)
# live = github.com, fixtures = bundled demo repositories (also: npm run demo)
REPORADAR_GITHUB_SOURCE=live
# Optional token to raise GitHub API rate limits. Public repositories only are ever served.
# GITHUB_TOKEN=replace-with-a-fine-grained-token-with-no-permissions
# Optional explicit HTTP CONNECT proxy for this server's GitHub traffic.
# REPORADAR_OUTBOUND_PROXY=http://proxy.internal:3128

# --- Execution (fails closed: disabled unless configured)
# disabled | docker
REPORADAR_RUNNER=disabled
# runsc (gVisor, required for any shared/public deployment) | runc (local development only)
REPORADAR_DOCKER_RUNTIME=runsc
# Required to use runc. Refused when NODE_ENV=production.
# REPORADAR_ALLOW_UNSAFE_LOCAL_RUNNER=i-understand-runc-is-not-a-strong-sandbox
# Point the Docker CLI at a dedicated sandbox host instead of the local daemon.
# REPORADAR_DOCKER_HOST=ssh://sandbox@sandbox-host.internal
# REPORADAR_DOCKER_BIN=docker

# Dependency downloads (both or neither). See deploy/compose.sandbox-host.yml.
# REPORADAR_FETCH_NETWORK=reporadar-fetch
# REPORADAR_FETCH_PROXY_URL=http://reporadar-egress:3128

# Sandbox images (pin by digest in production: name:tag@sha256:...)
# REPORADAR_IMAGE_NODE=node:24-bookworm-slim
# REPORADAR_IMAGE_PYTHON=python:3.13-slim-bookworm
# REPORADAR_IMAGE_GO=golang:1.25-bookworm
# REPORADAR_IMAGE_RUST=rust:1-slim-bookworm

# --- Per-run limits
# REPORADAR_RUN_CPUS=1
# REPORADAR_RUN_MEMORY_MB=2048
# REPORADAR_RUN_PIDS=256
# REPORADAR_RUN_WORKSPACE_MB=2048
# REPORADAR_INSTALL_TIMEOUT_SEC=300
# REPORADAR_CHECK_TIMEOUT_SEC=600
# REPORADAR_LOG_HEAD_KB=256
# REPORADAR_LOG_TAIL_KB=64

# --- Source limits
# REPORADAR_ARCHIVE_MAX_MB=50
# REPORADAR_ARCHIVE_MAX_UNCOMPRESSED_MB=250
# REPORADAR_ARCHIVE_MAX_FILES=20000
# REPORADAR_ARCHIVE_MAX_FILE_MB=25
# REPORADAR_REPO_MAX_REPORTED_MB=500
# REPORADAR_FETCH_TIMEOUT_SEC=30

# --- Abuse controls and retention
# REPORADAR_MAX_CONCURRENT_RUNS=2
# REPORADAR_MAX_QUEUED_RUNS=8
# REPORADAR_MAX_CONCURRENT_INSPECTIONS=4
# REPORADAR_RUNS_PER_IP_PER_HOUR=6
# REPORADAR_INSPECTIONS_PER_IP_PER_10_MIN=30
# REPORADAR_RUN_RETENTION_SEC=3600
# REPORADAR_INSPECTION_RETENTION_SEC=900
