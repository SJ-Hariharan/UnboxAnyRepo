# UnboxAnyRepo configuration. Copy to .env (never commit real values) and export,
# or set these in your process manager. Every value here is a placeholder.

# --- Web server
HOST=127.0.0.1
PORT=8787
# NODE_ENV=production
# Public origin used for CSRF origin checks behind a proxy, e.g. https://unboxanyrepo.example.com
# UNBOX_PUBLIC_ORIGIN=
# Set to true only when behind exactly one trusted reverse proxy that sets X-Forwarded-For.
# UNBOX_TRUST_PROXY=false
# Defaults to true when NODE_ENV=production.
# UNBOX_SECURE_COOKIES=

# --- Branding
# UNBOX_PRODUCT_NAME=UnboxAnyRepo

# --- GitHub (server-side only; never passed to the sandbox)
# live = github.com, fixtures = bundled demo repositories (also: npm run demo)
UNBOX_GITHUB_SOURCE=live
# Optional token to raise GitHub API rate limits. Public repositories only are ever served.
# GITHUB_TOKEN=replace-with-a-fine-grained-token-with-no-permissions
# Optional explicit HTTP CONNECT proxy for this server's GitHub traffic.
# UNBOX_OUTBOUND_PROXY=http://proxy.internal:3128

# --- Analysis (static: never executes repository code)
# External scanners: auto (use if installed) | off | semgrep,gitleaks
# UNBOX_SCANNERS=auto
# UNBOX_SEMGREP_BIN=semgrep
# UNBOX_GITLEAKS_BIN=gitleaks
# UNBOX_SCANNER_TIMEOUT_SEC=90
# Known-vulnerability lookup through api.osv.dev (default: on in live mode, off in demo mode)
# UNBOX_OSV=true
# Published repository advisories from the GitHub API (default: on in live mode)
# UNBOX_GITHUB_ADVISORIES=true
# Text read for analysis, per file and in total
# UNBOX_ANALYSIS_MAX_FILE_KB=512
# UNBOX_ANALYSIS_MAX_TOTAL_MB=40

# --- Previews (static files from the snapshot, or build output from a verified sandbox)
# UNBOX_PREVIEW=true
# Serve each preview at the root of <token>.<domain>, a separate site from the app.
# Default: preview.localhost when HOST is loopback and NODE_ENV is not production; otherwise off.
# In production this needs wildcard DNS (and a wildcard TLS certificate) for *.<domain>.
# UNBOX_PREVIEW_DOMAIN=preview.example.com
# UNBOX_PREVIEW_TTL_SEC=1800
# UNBOX_PREVIEW_MAX_MB=40
# UNBOX_PREVIEW_STORE_MB=256
# UNBOX_PREVIEWS_PER_SESSION=2

# --- Execution (fails closed: disabled unless configured AND verified)
# With runsc, execution also requires a live gVisor probe and a verification record
# written by `npm run sandbox -- --verify` after the real-container tests pass.
# UNBOX_SANDBOX_VERIFICATION_FILE=.unbox/sandbox-verification.json
# UNBOX_SANDBOX_VERIFICATION_MAX_AGE_DAYS=30
# disabled | docker
UNBOX_RUNNER=disabled
# runsc (gVisor, required for any shared/public deployment) | runc (local development only)
UNBOX_DOCKER_RUNTIME=runsc
# Required to use runc. Refused when NODE_ENV=production.
# UNBOX_ALLOW_UNSAFE_LOCAL_RUNNER=i-understand-runc-is-not-a-strong-sandbox
# Point the Docker CLI at a dedicated sandbox host instead of the local daemon.
# UNBOX_DOCKER_HOST=ssh://sandbox@sandbox-host.internal
# UNBOX_DOCKER_BIN=docker

# Dependency downloads (both or neither). See deploy/compose.sandbox-host.yml.
# UNBOX_FETCH_NETWORK=unbox-fetch
# UNBOX_FETCH_PROXY_URL=http://unbox-egress:3128

# Sandbox images (pin by digest in production: name:tag@sha256:...)
# UNBOX_IMAGE_NODE=node:24-bookworm-slim
# UNBOX_IMAGE_PYTHON=python:3.13-slim-bookworm
# UNBOX_IMAGE_GO=golang:1.25-bookworm
# UNBOX_IMAGE_RUST=rust:1-slim-bookworm

# --- Egress proxy (read by `npm run egress-proxy` / deploy/compose.sandbox-host.yml, not by the web server)
# UNBOX_EGRESS_HOST=0.0.0.0
# UNBOX_EGRESS_PORT=3128
# UNBOX_EGRESS_ALLOWLIST=registry.npmjs.org,pypi.org,files.pythonhosted.org,proxy.golang.org,sum.golang.org,index.crates.io,static.crates.io

# --- Per-run limits
# UNBOX_RUN_CPUS=1
# UNBOX_RUN_MEMORY_MB=2048
# UNBOX_RUN_PIDS=256
# UNBOX_RUN_WORKSPACE_MB=2048
# UNBOX_INSTALL_TIMEOUT_SEC=300
# UNBOX_CHECK_TIMEOUT_SEC=600
# UNBOX_LOG_HEAD_KB=256
# UNBOX_LOG_TAIL_KB=64

# --- Source limits
# UNBOX_ARCHIVE_MAX_MB=50
# UNBOX_ARCHIVE_MAX_UNCOMPRESSED_MB=250
# UNBOX_ARCHIVE_MAX_FILES=20000
# UNBOX_ARCHIVE_MAX_FILE_MB=25
# UNBOX_REPO_MAX_REPORTED_MB=500
# UNBOX_FETCH_TIMEOUT_SEC=30

# --- Abuse controls and retention
# UNBOX_MAX_CONCURRENT_RUNS=2
# UNBOX_MAX_QUEUED_RUNS=8
# UNBOX_MAX_CONCURRENT_INSPECTIONS=4
# UNBOX_RUNS_PER_IP_PER_HOUR=6
# UNBOX_INSPECTIONS_PER_IP_PER_10_MIN=30
# UNBOX_RUN_RETENTION_SEC=3600
# UNBOX_INSPECTION_RETENTION_SEC=900
# Memory cap for all held inspections (archives + analysis)
# UNBOX_INSPECTION_STORE_MB=512
